rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // global security helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "bhaktisagar9199@gmail.com"
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins Collection: Auth checks + access control list
    match /admins/{adminId} {
      allow get: if isVerified() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isVerified() && (
        isAdmin() || 
        (request.auth.uid == adminId && request.auth.token.email == "bhaktisagar9199@gmail.com")
      );
      allow delete: if isAdmin() && adminId != request.auth.uid; // Prevent self-deletion
    }
    
    // CMS Content Collection: Public reads with administrative writes
    match /cms_content/{contentId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(contentId);
    }
  }
}
